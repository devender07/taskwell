# /etc/taskwell-backup.env (chmod 600). Copy to etc/taskwell-backup.env (git-ignored) and fill in; empty R2_BUCKET keeps
# backups on the server only.
# Cloudflare R2: make a bucket (e.g. taskwell-backups), then R2 > Manage API tokens > Create: Object Read & Write,
# applied to that bucket only. The account id is in the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taskwell-backups
# Encrypts each dump before it leaves the server. Keep a copy somewhere else: without it the R2 copies can't be read.
# openssl rand -base64 32
BACKUP_PASSPHRASE=
R2_KEEP_DAYS=30
# BACKUP_DIR=/backups/taskwell
# KEEP_DAYS=14
