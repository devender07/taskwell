# APP_HOST serves the user SPA and proxies /api to the user service and /mcp to the MCP server; ADMIN_HOST does the same for admin.
# Hosts that are real domain names get automatic HTTPS.

(spa) {
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: {$S3_ORIGIN}; media-src 'self' {$S3_ORIGIN}; style-src 'self' 'unsafe-inline'; connect-src 'self' wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# The API sets its own Cache-Control (e.g. no-store on auth, private on files); Caddy only proxies.
	# flush_interval -1 passes streams (the AI test live view) through as they're written.
	handle /api/* {
		reverse_proxy {args[0]} {
			flush_interval -1
		}
	}

	# Hashed build output: cache forever, and a missing file is a 404, not index.html.
	handle /assets/* {
		root * {args[1]}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else falls back to index.html for client-side routes, revalidated on every load.
	handle {
		root * {args[1]}
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	encode zstd gzip
}

{$APP_HOST:localhost} {
	# The MCP server for AI tools; it calls the user API with the caller's token.
	handle /mcp {
		reverse_proxy mcp:8095 {
			flush_interval -1
		}
	}
	# OAuth discovery for MCP clients (docs/mcp-oauth-plan.md): the MCP server describes itself, the user service is
	# the authorization server.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy mcp:8095
	}
	handle /.well-known/oauth-authorization-server* {
		reverse_proxy user:8090
	}
	# / is the static landing page (built from frontend/user/landing.html); the app lives at /{workspace}, /signin and the rest.
	handle / {
		root * /srv/user
		header Cache-Control no-cache
		rewrite * /landing.html
		file_server
	}
	import spa user:8090 /srv/user
}

{$ADMIN_HOST:admin.localhost} {
	# Optional allowlist at the edge, on top of the admin service's own ADMIN_ALLOWED_IPS. To opt in, uncomment these
	# four lines, set ADMIN_CADDY_ALLOWED_IPS in .env to space-separated addresses or CIDR ranges and pass it to the
	# caddy service in docker-compose.prod.yml. remote_ip is the TCP peer, right for Caddy at the edge; use client_ip
	# with trusted_proxies if a load balancer sits in front. This handle sorts before the snippet's.
	# @blocked not remote_ip {$ADMIN_CADDY_ALLOWED_IPS}
	# handle @blocked {
	# 	respond "Forbidden" 403
	# }
	import spa admin:8080 /srv/admin
}
