# Copy to deploy/.env (git-ignored) and fill in. Never commit the real file.

# Public hostnames. Real domains get automatic HTTPS from Caddy; DNS must point here first.
APP_HOST=app.example.com
ADMIN_HOST=admin.example.com

APP_ENV=production

POSTGRES_USER=tether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tether

# 32+ random bytes each, different from each other: openssl rand -base64 48
JWT_SECRET=
ADMIN_JWT_SECRET=

# Pool sizes per service. Keep their sum under Postgres max_connections (100 by default).
DB_MAX_CONNS=20
ADMIN_DB_MAX_CONNS=5
# Per-session Postgres limits (both services): a stuck query or an abandoned transaction can't hold a connection.
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_TX_TIMEOUT=2min

# How often the notification worker runs, and how long an issue must be quiet before its email goes out.
NOTIFY_INTERVAL=1m
NOTIFY_SETTLE=30s

# Outbound email queue: how long one SMTP send may take, the first retry wait (doubles, up to 1h) and how many
# failed sends before an email is given up (it stays in outbound_mail with its error).
MAIL_TIMEOUT=20s
MAIL_RETRY_BASE=30s
MAIL_MAX_ATTEMPTS=8
