# Copy to deploy/.env (git-ignored) and fill in. Never commit the real file.

# Public hostnames. Real domains get automatic HTTPS from Caddy; DNS must point here first.
APP_HOST=app.example.com
ADMIN_HOST=admin.example.com

APP_ENV=production

POSTGRES_USER=tether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tether

# 32+ random bytes each, different from each other: openssl rand -base64 48
JWT_SECRET=
ADMIN_JWT_SECRET=

# Pool sizes per service. Keep their sum under Postgres max_connections (100 by default).
DB_MAX_CONNS=20
ADMIN_DB_MAX_CONNS=5

# How often the notification worker runs, and how long an issue must be quiet before its email goes out.
NOTIFY_INTERVAL=1m
NOTIFY_SETTLE=30s
