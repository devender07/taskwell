# Copy to deploy/.env (git-ignored) and fill in. Never commit the real file.

# Public hostnames. Real domains get automatic HTTPS from Caddy; DNS must point here first.
APP_HOST=app.example.com
ADMIN_HOST=admin.example.com
# Where presigned upload links point (the CSP allows images and media from it): the s3_endpoint origin in system_config,
# or https://<bucket>.s3.<region>.amazonaws.com on AWS.
S3_ORIGIN=https://taskwell-uploads.s3.us-east-1.amazonaws.com

APP_ENV=production

POSTGRES_USER=taskwell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskwell

# 32+ random bytes each, different from each other: openssl rand -base64 48
JWT_SECRET=
ADMIN_JWT_SECRET=
# Encrypts admins' TOTP secrets at rest (AES-GCM). 32+ random bytes, different from the two above. Changing it makes
# every stored factor unreadable: then run taskwell-admin -reset-mfa for each admin.
MFA_ENCRYPTION_KEY=

# Seals test account passwords for AI test runs (AES-GCM), on the user service and the tester. 32+ random bytes,
# different from the others. Changing it makes every saved test account password unreadable: save them again.
TEST_SECRET_KEY=
# Seals GitHub / GitLab webhook secrets (AES-GCM) on the user service. 32+ random bytes, different from the others.
# Changing it breaks every connected webhook: regenerate the secret in Settings → Integrations.
INTEGRATION_SECRET_KEY=
# Claude API key for AI test runs, read only by the tester (the ai profile). Never put it in system_config.
ANTHROPIC_API_KEY=
# AI test runs one tester runs at once, and its pool size.
AI_TEST_BROWSERS=2
TESTER_DB_MAX_CONNS=5

# Addresses allowed to reach the admin API: comma-separated IPs or CIDR ranges, e.g. 203.0.113.0/24,198.51.100.7.
# Empty allows any address (logged as a warning in production).
ADMIN_ALLOWED_IPS=

# Pool sizes per service. Keep their sum under Postgres max_connections (100 by default).
DB_MAX_CONNS=20
ADMIN_DB_MAX_CONNS=5
# Per-session Postgres limits (both services): a stuck query or an abandoned transaction can't hold a connection.
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_TX_TIMEOUT=2min

# How often the notification worker runs, and how long an issue must be quiet before its email goes out.
NOTIFY_INTERVAL=1m
NOTIFY_SETTLE=30s

# Outbound email queue: how long one SMTP send may take, the first retry wait (doubles, up to 1h) and how many
# failed sends before an email is given up (it stays in outbound_mail with its error).
MAIL_TIMEOUT=20s
MAIL_RETRY_BASE=30s
MAIL_MAX_ATTEMPTS=8

# Logs go to stdout as JSON (the default with APP_ENV=production); text is easier to read by eye.
LOG_FORMAT=json

# /metrics (Prometheus text) and /readyz listen here, never on the public port. Loopback keeps them inside the
# container (the healthcheck runs there); to scrape from a Prometheus container on the compose network use :9090 and
# :9091, and still publish no port for them.
METRICS_ADDR=127.0.0.1:9090
ADMIN_METRICS_ADDR=127.0.0.1:9091

# How often the retention sweep runs (expired tokens, old read notifications, given-up email, unreferenced uploads).
SWEEP_INTERVAL=24h

# How long a migration waits for a table lock before failing (it's then rerun by the next release).
MIGRATE_LOCK_TIMEOUT=10s
