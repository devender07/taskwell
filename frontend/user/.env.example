VITE_API_URL=https://api.example.com
VITE_MCP_URL=https://mcp.example.com/mcp
# Optional: the storage bucket's origin, allowed in the CSP's connect-src.
VITE_UPLOAD_ORIGIN=https://bucket.example.com
# sandbox or production
VITE_PADDLE_ENV=sandbox
# Paddle client-side token (test_… in sandbox, live_… in production). Never the server API key.
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx
